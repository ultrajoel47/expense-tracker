# Base de datos
DATABASE_URL="mongodb+srv://usuario:password@host/expense-tracker"

# Sesiones — obligatorio, sin fallback. Generar con: openssl rand -base64 32
JWT_SECRET=""

# Miembros del hogar — ALLOWLIST de emails habilitados a tener cuenta, separados
# por coma. Es la FUENTE UNICA DE VERDAD de las dos mitades del modelo de
# privacidad: quien puede registrarse (`POST /api/auth/register` devuelve 403 al
# resto) y de quien se ven los gastos con `scope: "casa"`
# (`src/lib/visibility.ts`). No hay un flag en la base a proposito: seria un
# segundo lugar donde vive la misma verdad.
#
# Si NO se define:
#   - con NODE_ENV=production se FALLA CERRADO: nadie puede registrarse y nadie
#     es miembro, asi que no se ve ningun gasto de casa. Un default permisivo en
#     un dominio publico seria exactamente el agujero que esta variable tapa.
#   - fuera de produccion se abre, para no dejar el desarrollo local sin poder
#     crear el primer usuario ni ver un solo gasto.
HOUSEHOLD_EMAILS="uno@ejemplo.com,dos@ejemplo.com"

# Bot de Telegram
TELEGRAM_BOT_TOKEN=""
# Secret del header X-Telegram-Bot-Api-Secret-Token. Generar con: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""
# Usuario del bot, sin la @. Solo se usa en el front, para que el boton
# "Vincular Telegram" pueda linkear directo al chat. Opcional.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="ExpenseTracker3004Bot"
# Base de la Bot API. SOLO para pruebas locales, apuntando a un mock que
# registre los mensajes que el bot manda. En produccion se deja SIN DEFINIR.
# TELEGRAM_API_BASE_URL="http://localhost:4567"

# IA — elige la implementacion de AiProvider: "groq" (default) o "grok"
AI_PROVIDER="groq"

# IA — Groq (openai-compatible). Modelos disponibles: GET /openai/v1/models
GROQ_API_KEY=""
GROQ_MODEL=""

# IA — Grok (xAI), alternativa. Requiere credito en la cuenta de xAI.
XAI_API_KEY=""
XAI_MODEL="grok-4-fast"

# OCR — "wasm" en Vercel, "native" en el VPS. Se usa desde la Rebanada 4.
OCR_ENGINE="wasm"
